# OpenTelemetry Collector endpoints
# Base URL used to derive the individual endpoints when specific ones are not provided
OTEL_COLLECTOR_URL=http://localhost:4318

# Optional overrides for specific OTLP endpoints
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs

# Optional comma separated list of headers for the OTLP exporters (key=value pairs)
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic abc123,X-Custom-Header=value

# DEV.to API authentication
DEVTO_API_KEY=your_devto_api_key

# Optional overrides for service metadata
OTEL_SERVICE_NAME=devto-news-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_INSTANCE_ID=local-instance

# Logging configuration
LOG_LEVEL=INFO
